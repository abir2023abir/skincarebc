---
import { site, orderables } from '~/config/site';
import { divisions } from '~/lib/districts';
import { formatBdt } from '~/lib/formatBdt';
import Icon from '~/components/ui/Icon.astro';

/**
 * Checkout, rendered server-side and inert until opened.
 *
 * Built on native <dialog>. showModal() gives a real focus trap, Esc-to-close,
 * background inertness, ::backdrop and focus restoration to the trigger — all
 * of which would otherwise be a few hundred lines of bundled JavaScript to get
 * right, and would still be worse.
 *
 * Prices and numbers are handed to the client as one small JSON island rather
 * than by importing site.ts, which would drag the whole Bangla catalogue into
 * the bundle for the sake of four numbers.
 *
 * Views: cart → form → done
 */


const enabledMethods: ('bkash' | 'cod')[] = [
  ...(site.paymentMethods.bkash ? ['bkash' as const] : []),
  ...(site.paymentMethods.cod ? ['cod' as const] : []),
];

const checkoutData = {
  items: orderables.map((o) => ({ id: o.id, name: o.name, price: o.price })),
  delivery: site.deliveryCharge,
  bkashNumber: site.bkashNumber,
  whatsappNumber: site.whatsappNumber,
  orderPrefix: site.orderPrefix,
  /** 'Send Money' for a personal wallet, 'Payment' for a merchant one. */
  bkashAction: site.bkashAccountType === 'Merchant' ? 'Payment' : 'Send Money',
  paymentMethods: enabledMethods,
};

const showPaymentChoice = enabledMethods.length > 1;
---

<script type="application/json" id="checkout-data" set:html={JSON.stringify(checkoutData)} is:inline
></script>

<dialog class="sheet" id="checkout" aria-labelledby="checkout-title" data-checkout>
  <div class="shell">
    <!-- ── Cart view ─────────────────────────────────────────────────── -->
    <div class="view" data-view="cart">
      <header class="head">
        <div>
          <p class="eyebrow">শপিং ব্যাগ</p>
          <h2 class="title" id="checkout-title">আপনার কার্ট</h2>
        </div>
        <button type="button" class="close" data-checkout-close aria-label="বন্ধ করুন">
          <Icon name="close" size={20} />
        </button>
      </header>

      <!-- Empty state -->
      <div class="cart-empty" data-cart-empty>
        <p class="cart-empty-icon" aria-hidden="true"><Icon name="bag" size={32} /></p>
        <p class="cart-empty-text">আপনার কার্ট খালি।</p>
        <p class="cart-empty-sub">পণ্য বেছে "কার্টে যোগ করুন" বোতামে চাপুন।</p>
      </div>

      <!-- Item list (populated by JS) -->
      <ul class="cart-list" data-cart-list aria-label="কার্টের পণ্য তালিকা"></ul>

      <!-- Cart summary + proceed button -->
      <div class="cart-foot" data-cart-foot>
        <div class="summary" aria-live="polite">
          <p class="sum-row">
            <span>সাবটোটাল</span>
            <span data-sum="cart-subtotal">—</span>
          </p>
          <p class="sum-row">
            <span>ডেলিভারি চার্জ</span>
            <span data-sum="cart-delivery">—</span>
          </p>
          <p class="sum-row sum-total">
            <span>সর্বমোট</span>
            <span data-sum="cart-total">—</span>
          </p>
        </div>
        <button type="button" class="btn btn-primary confirm" data-cart-checkout>
          <Icon name="arrow-right" size={18} />
          <span>চেকআউট করুন</span>
        </button>
        <p class="legal">পণ্য বেছে নিন, বিস্তারিত পূরণ করুন, WhatsApp-এ অর্ডার করুন।</p>
      </div>
    </div>

    <!-- ── Form view ────────────────────────────────────────────────── -->
    <div class="view" data-view="form" hidden>
      <header class="head">
        <div>
          <p class="eyebrow">অর্ডার ফর্ম</p>
          <h2 class="title" id="checkout-form-title">অর্ডার করুন</h2>
        </div>
        <button type="button" class="close" data-checkout-close aria-label="বন্ধ করুন">
          <Icon name="close" size={20} />
        </button>
      </header>

      <form class="form" data-checkout-form novalidate>
        <!-- Read-only cart summary at the top of the form -->
        <div class="cart-recap" data-cart-recap aria-label="কার্ট সারসংক্ষেপ"></div>

        <!-- Name -->
        <div class="field">
          <label class="label" for="co-name">পুরো নাম</label>
          <input
            class="input"
            id="co-name"
            name="name"
            type="text"
            autocomplete="name"
            enterkeyhint="next"
            aria-describedby="err-name"
            required
          />
          <p class="err" id="err-name" data-err="name" role="alert"></p>
        </div>

        <!-- Mobile -->
        <div class="field">
          <label class="label" for="co-mobile">মোবাইল নম্বর</label>
          <input
            class="input"
            id="co-mobile"
            name="mobile"
            type="tel"
            inputmode="numeric"
            autocomplete="tel-national"
            placeholder="01XXXXXXXXX"
            enterkeyhint="next"
            aria-describedby="err-mobile hint-mobile"
            required
          />
          <p class="hint" id="hint-mobile">যে নম্বরে কল বা WhatsApp করা যাবে।</p>
          <p class="err" id="err-mobile" data-err="mobile" role="alert"></p>
        </div>

        <!-- District -->
        <div class="field">
          <label class="label" for="co-district">জেলা</label>
          <div class="control">
            <select
              class="input select"
              id="co-district"
              name="district"
              autocomplete="address-level1"
              aria-describedby="err-district"
              required
            >
              <option value="" selected disabled>জেলা বেছে নিন</option>
              {
                divisions.map((division) => (
                  <optgroup label={`${division.name} বিভাগ`}>
                    {division.districts.map((d) => (
                      <option value={d}>{d}</option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
            <span class="select-arrow" aria-hidden="true"><Icon name="chevron" size={16} /></span>
          </div>
          <p class="err" id="err-district" data-err="district" role="alert"></p>
        </div>

        <!-- Address -->
        <div class="field">
          <label class="label" for="co-address">সম্পূর্ণ ঠিকানা</label>
          <textarea
            class="input area"
            id="co-address"
            name="address"
            rows="3"
            autocomplete="street-address"
            placeholder="বাড়ি/হোল্ডিং, রোড, এলাকা, থানা"
            aria-describedby="err-address"
            required></textarea>
          <p class="err" id="err-address" data-err="address" role="alert"></p>
        </div>

        <!-- Delivery area -->
        <fieldset class="field area-field">
          <legend class="label">ডেলিভারি এলাকা</legend>
          <div class="areas">
            <span class="area-item">
              <input type="radio" name="area" id="co-area-inside" value="inside" checked class="sr-only" />
              <label class="area-label" for="co-area-inside">
                <span class="area-name">ঢাকার ভিতরে</span>
                <span class="area-cost">{formatBdt(site.deliveryCharge.insideDhaka)}</span>
              </label>
            </span>
            <span class="area-item">
              <input type="radio" name="area" id="co-area-outside" value="outside" class="sr-only" />
              <label class="area-label" for="co-area-outside">
                <span class="area-name">ঢাকার বাইরে</span>
                <span class="area-cost">{formatBdt(site.deliveryCharge.outsideDhaka)}</span>
              </label>
            </span>
          </div>
          <p class="err" id="err-area" data-err="area" role="alert"></p>
        </fieldset>

        <!-- Payment method (only shown when both are enabled) -->
        {showPaymentChoice && (
          <fieldset class="field area-field" id="co-payment-fieldset">
            <legend class="label">পেমেন্ট পদ্ধতি</legend>
            <div class="areas">
              {site.paymentMethods.bkash && (
                <span class="area-item">
                  <input type="radio" name="paymentMethod" id="co-pay-bkash" value="bkash" checked class="sr-only" />
                  <label class="area-label" for="co-pay-bkash">
                    <span class="area-name">bKash Send Money</span>
                    <span class="area-cost">অ্যাকাউন্টে পাঠান</span>
                  </label>
                </span>
              )}
              {site.paymentMethods.cod && (
                <span class="area-item">
                  <input type="radio" name="paymentMethod" id="co-pay-cod" value="cod" class="sr-only" />
                  <label class="area-label" for="co-pay-cod">
                    <span class="area-name">ক্যাশ অন ডেলিভারি</span>
                    <span class="area-cost">পৌঁছে দিলে পরিশোধ</span>
                  </label>
                </span>
              )}
            </div>
            <p class="err" id="err-paymentMethod" data-err="paymentMethod" role="alert"></p>
          </fieldset>
        )}

        <!-- Note -->
        <div class="field">
          <label class="label" for="co-note">
            নোট <span class="optional">(না লিখলেও চলবে)</span>
          </label>
          <textarea
            class="input area"
            id="co-note"
            name="note"
            rows="2"
            placeholder="কোনো নির্দেশনা থাকলে লিখুন"></textarea>
        </div>

        <!-- ── Summary ─────────────────────────────────────────────── -->
        <div class="summary" aria-live="polite">
          <p class="sum-row">
            <span>সাবটোটাল</span>
            <span data-sum="subtotal">—</span>
          </p>
          <p class="sum-row">
            <span>ডেলিভারি চার্জ</span>
            <span data-sum="delivery">—</span>
          </p>
          <p class="sum-row sum-total">
            <span>সর্বমোট</span>
            <span data-sum="total">—</span>
          </p>
        </div>

        <!-- ── bKash card ──────────────────────────────────────────── -->
        <div class="bkash" data-payment-target="bkash">
          <div class="bkash-top">
            <p class="bkash-brand">
              <span class="bkash-mark" aria-hidden="true"><Icon name="wallet" size={16} /></span>
              <span>bKash</span>
              <span class="bkash-type">{site.bkashAccountType}</span>
            </p>
            <button type="button" class="copy" data-copy={site.bkashNumber}>
              <span class="copy-idle">
                <Icon name="copy" size={15} />
                <span>কপি</span>
              </span>
              <span class="copy-done" aria-hidden="true">
                <Icon name="check" size={15} />
                <span>কপি হয়েছে</span>
              </span>
            </button>
          </div>

          <p class="bkash-number">{site.bkashNumber}</p>

          <p class="bkash-help">
            উপরের নাম্বারে মোট <strong data-sum="total-inline">—</strong>
            {' '}{checkoutData.bkashAction} করুন, তারপর WhatsApp-এ ট্রানজেকশনের স্ক্রিনশট পাঠান।
          </p>
        </div>

        <!-- ── COD info ────────────────────────────────────────────── -->
        <div class="cod" data-payment-target="cod" hidden>
          <p class="cod-icon" aria-hidden="true"><Icon name="truck" size={20} /></p>
          <div>
            <p class="cod-title">ক্যাশ অন ডেলিভারি</p>
            <p class="cod-help">
              পণ্য বাড়িতে পৌঁছানোর সময় কুরিয়ারকে মোট
              <strong data-sum="total-inline-cod">—</strong> নগদে পরিশোধ করুন।
            </p>
          </div>
        </div>

        <button type="submit" class="btn btn-primary confirm">
          <Icon name="chat" size={18} />
          <span>WhatsApp-এ অর্ডার কনফার্ম করুন</span>
        </button>

        <p class="legal">
          কনফার্ম করলে WhatsApp খুলবে আপনার অর্ডারের তথ্যসহ। মেসেজটি পাঠালে তবেই অর্ডার গণ্য হবে।
        </p>
      </form>
    </div>

    <!-- ── Success view ─────────────────────────────────────────────── -->
    <div class="view" data-view="done" hidden>
      <div class="done">
        <p class="done-mark" aria-hidden="true"><Icon name="check" size={28} /></p>

        <h2 class="done-title">অর্ডারের তথ্য পাঠানো হয়েছে</h2>
        <p class="done-sub">
          WhatsApp খোলেনি? নিচের বাটনে আবার চাপ দিন — তথ্য একই থাকবে।
        </p>

        <dl class="done-facts">
          <div>
            <dt>অর্ডার আইডি</dt>
            <dd data-done="orderId">—</dd>
          </div>
          <div>
            <dt>মোট</dt>
            <dd data-done="total">—</dd>
          </div>
          {site.paymentMethods.bkash && (
            <div data-done-bkash>
              <dt>bKash নাম্বার</dt>
              <dd class="done-bkash">
                <span>{site.bkashNumber}</span>
                <button type="button" class="copy copy-sm" data-copy={site.bkashNumber}>
                  <span class="copy-idle">
                    <Icon name="copy" size={14} />
                    <span>কপি</span>
                  </span>
                  <span class="copy-done" aria-hidden="true">
                    <Icon name="check" size={14} />
                    <span>হয়েছে</span>
                  </span>
                </button>
              </dd>
            </div>
          )}
        </dl>

        <p class="done-remind" data-done-bkash-remind>
          <Icon name="camera" size={16} />
          <span>টাকা পাঠানোর পর ট্রানজেকশনের স্ক্রিনশটটি WhatsApp-এ পাঠাতে ভুলবেন না।</span>
        </p>

        <div class="done-actions">
          <a class="btn btn-primary" data-done="wa" href="#" target="_blank" rel="noopener noreferrer">
            <Icon name="chat" size={18} />
            <span>আবার WhatsApp খুলুন</span>
          </a>
          <button type="button" class="btn btn-ghost" data-checkout-close>বন্ধ করুন</button>
        </div>
      </div>
    </div>
  </div>
</dialog>

<style>
  /* ── Dialog frame ────────────────────────────────────────────────────── */
  .sheet {
    width: 100%;
    max-width: 30rem;
    max-height: 100dvh;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    overflow: visible;
  }

  .sheet::backdrop {
    background: rgb(19 19 19 / 0.55);
    backdrop-filter: blur(3px);
  }

  .shell {
    max-height: 92dvh;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--color-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-float);
    -webkit-overflow-scrolling: touch;
  }

  /* Bottom sheet on phones, centred modal from 34rem up. */
  .sheet {
    margin: 0 auto auto;
    position: fixed;
    inset: auto 0 0;
  }

  .shell {
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }

  @media (min-width: 34rem) {
    .sheet {
      inset: 0;
      margin: auto;
    }

    .shell {
      border-radius: var(--radius-lg);
    }
  }

  /* Slide up / fade in. Transform and opacity only. */
  .sheet[open] .shell {
    animation: sheet-in var(--dur-base) var(--ease-out-soft);
  }

  @keyframes sheet-in {
    from {
      opacity: 0;
      transform: translateY(2.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sheet[open] .shell {
      animation: none;
    }
  }

  /* ── Head ────────────────────────────────────────────────────────────── */
  .head {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem clamp(1rem, 4vw, 1.5rem) 0.9rem;
    background: var(--color-card);
    border-bottom: 1px solid var(--color-line);
  }

  .title {
    margin-top: 0.3rem;
    font-size: var(--text-xl);
  }

  .close {
    display: grid;
    place-items: center;
    /* 44px tap target. */
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 0;
    border-radius: var(--radius-pill);
    background: var(--color-page);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-soft);
  }

  .close:hover {
    background: var(--color-beige);
  }

  /* ── Cart view ───────────────────────────────────────────────────────── */
  .cart-empty {
    display: none;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 3rem 1.5rem;
    text-align: center;
    color: var(--color-ink-mute);
  }

  [data-cart-empty]:not([hidden]) {
    display: flex;
  }

  .cart-empty-icon {
    color: var(--color-line-strong);
  }

  .cart-empty-text {
    font-weight: 700;
    color: var(--color-ink-soft);
  }

  .cart-empty-sub {
    font-size: var(--text-sm);
  }

  .cart-list {
    list-style: none;
    margin: 0;
    padding: 0.75rem clamp(1rem, 4vw, 1.5rem) 0;
    display: grid;
    gap: 0.75rem;
  }

  /* JS populates <li> elements with class .cart-item */
  :global(.cart-item) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--color-page);
    border-radius: var(--radius-sm);
  }

  :global(.cart-item-name) {
    flex: 1;
    min-width: 0;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.4;
  }

  :global(.cart-item-price) {
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }

  :global(.cart-item-stepper) {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
  }

  :global(.cart-step) {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-xs);
    background: var(--color-card);
    cursor: pointer;
    font-size: var(--text-sm);
    font-weight: 700;
    transition: background-color var(--dur-fast) var(--ease-out-soft);
  }

  :global(.cart-step:hover:not(:disabled)) {
    background: var(--color-beige);
    border-color: var(--color-ink);
  }

  :global(.cart-step:disabled) {
    opacity: 0.35;
    cursor: not-allowed;
  }

  :global(.cart-qty) {
    width: 1.75rem;
    text-align: center;
    font-size: var(--text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  :global(.cart-remove) {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    flex: none;
    border: 0;
    border-radius: var(--radius-xs);
    background: transparent;
    color: var(--color-ink-mute);
    cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out-soft);
  }

  :global(.cart-remove:hover) {
    color: var(--color-orange-deep);
  }

  .cart-foot {
    padding: 1rem clamp(1rem, 4vw, 1.5rem) 1.5rem;
    display: grid;
    gap: 1rem;
  }

  /* ── Cart recap in form view ─────────────────────────────────────────── */
  :global(.recap-item) {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem;
    font-size: var(--text-sm);
    padding: 0.5rem 0;
    border-bottom: 1px solid var(--color-line);
  }

  :global(.recap-item:last-child) {
    border-bottom: none;
  }

  :global(.recap-name) {
    color: var(--color-ink-soft);
  }

  :global(.recap-qty-price) {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cart-recap {
    background: var(--color-page);
    border-radius: var(--radius-sm);
    padding: 0.5rem 1rem;
    margin-bottom: 0.25rem;
  }

  /* ── Form ────────────────────────────────────────────────────────────── */
  .form {
    display: grid;
    gap: 1rem;
    padding: 1.15rem clamp(1rem, 4vw, 1.5rem) 1.5rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .label {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .optional {
    font-weight: 500;
    color: var(--color-ink-mute);
  }

  .input {
    width: 100%;
    /* 46px — comfortably over the tap-target floor, and stops iOS zooming in
       on focus because the font-size is 16px. */
    min-height: 2.875rem;
    padding: 0.7rem 0.9rem;
    font-size: 1rem;
    background: var(--color-page);
    border: 1px solid transparent;
    border-radius: var(--radius-sm);
    transition:
      border-color var(--dur-fast) var(--ease-out-soft),
      background-color var(--dur-fast) var(--ease-out-soft);
  }

  .input:focus {
    background: var(--color-card);
    border-color: var(--color-ink);
  }

  .input[aria-invalid='true'] {
    border-color: var(--color-orange);
    background: color-mix(in oklab, var(--color-orange) 6%, var(--color-card));
  }

