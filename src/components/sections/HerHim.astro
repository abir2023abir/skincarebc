---
import { Image } from 'astro:assets';
import { site } from '~/config/site';
import { productImage, sceneImage } from '~/lib/images';
import { formatBdt } from '~/lib/formatBdt';
import Icon from '~/components/ui/Icon.astro';

/**
 * For Her / For Him.
 *
 * Desktop: a true split where hovering (or focusing anything inside) one side
 * re-weights the grid 1.25fr / 0.75fr. The weighting is a grid-template
 * transition on the container, so nothing inside re-lays-out per frame.
 *
 * Mobile: the split becomes two stacked cards. No swipe carousel here — the
 * two panels carry real content and a rail would hide half of it behind a
 * gesture on the page's most important navigational choice.
 */

const lines = [
  {
    id: 'for-her',
    key: 'her' as const,
    label: 'For Her',
    labelBn: 'নারীদের জন্য',
    blurb: 'দাগ হালকা করা আর আর্দ্রতা ধরে রাখা — দুই ধাপে পরিষ্কার একটা রুটিন।', // «placeholder»
    scene: 'model-hero.jpg',
    sceneAlt: 'একজন নারী মুখে সিরাম লাগাচ্ছেন',
  },
  {
    id: 'for-him',
    key: 'him' as const,
    label: 'For Him',
    labelBn: 'পুরুষদের জন্য',
    blurb: 'তেল নিয়ন্ত্রণ আর শেভের পরের আরাম — দিনে দুই মিনিটের যত্ন।', // «placeholder»
    // A product still, not a portrait: every model shot on the site is a
    // woman, so a woman's face would read oddly at the head of "For Him".
    scene: 'scene-3.jpg',
    sceneAlt: 'পুরুষদের জন্য অয়েল কন্ট্রোল ও আফটার শেভ প্রোডাক্ট',
  },
];

const byLine = lines.map((line) => ({
  ...line,
  products: site.products.filter((p) => p.line === line.key),
}));
---

<section class="section split-section">
  <div class="wrap">
    <header class="head">
      <p class="eyebrow">দুটি লাইন</p>
      <h2 class="title">
        <span class="display">For Her</span>
        <span class="slash" aria-hidden="true">/</span>
        <span class="display">For Him</span>
      </h2>
      <p class="sub">একই গবেষণা, আলাদা ফর্মুলা। যার ত্বক যেমন, তার জন্য তেমন।</p>
    </header>

    <div class="split" data-split>
      {
        byLine.map((line) => (
          <article class="side" id={line.id} data-side={line.key}>
            <div class="side-media">
              <Image
                src={sceneImage(line.scene)}
                alt={line.sceneAlt}
                widths={[380, 680]}
                sizes="(max-width: 60rem) 92vw, 44vw"
                loading="lazy"
              />
              <p class="side-tag">{line.labelBn}</p>
            </div>

            <div class="side-body">
              <h3 class="side-title display">{line.label}</h3>
              <p class="side-blurb">{line.blurb}</p>

              <ul class="side-list">
                {line.products.map((p) => (
                  <li>
                    <button type="button" class="pick" data-order-open={p.id}>
                      <span class="pick-thumb">
                        <Image
                          src={productImage(p.image)}
                          alt=""
                          aria-hidden="true"
                          widths={[64, 128]}
                          sizes="64px"
                          loading="lazy"
                        />
                      </span>
                      <span class="pick-text">
                        <span class="pick-name en">{p.name}</span>
                        <span class="pick-meta">
                          {p.size} · {formatBdt(p.price)}
                        </span>
                      </span>
                      <span class="pick-go" aria-hidden="true">
                        <Icon name="arrow-right" size={16} />
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .split-section {
    position: relative;
  }

  .head {
    max-width: 40rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: 0.75rem;
    font-size: var(--text-4xl);
  }

  .slash {
    color: var(--color-orange);
  }

  .sub {
    margin-top: 0.9rem;
    max-width: 30rem;
    color: var(--color-ink-soft);
  }

  /* ── Split ───────────────────────────────────────────────────────────── */
  .split {
    display: grid;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
  }

  @media (min-width: 60rem) {
    .split {
      grid-template-columns: 1fr 1fr;
      /* The re-weighting itself. One property, on the container only. */
      transition: grid-template-columns var(--dur-base) var(--ease-in-out-soft);
    }

    /* :focus-within keeps the expansion reachable from the keyboard. */
    .split:has(.side:nth-child(1):hover),
    .split:has(.side:nth-child(1):focus-within) {
      grid-template-columns: 1.3fr 0.7fr;
    }

    .split:has(.side:nth-child(2):hover),
    .split:has(.side:nth-child(2):focus-within) {
      grid-template-columns: 0.7fr 1.3fr;
    }
  }

  .side {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--color-card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
    overflow: hidden;
  }

  /* ── Media ───────────────────────────────────────────────────────────── */
  .side-media {
    position: relative;
  }

  .side-media :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }

  .side-tag {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--color-card) 90%, transparent);
    backdrop-filter: blur(8px);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  /* ── Body ────────────────────────────────────────────────────────────── */
  .side-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.1rem, 2.4vw, 1.75rem);
  }

  .side-title {
    font-size: var(--text-2xl);
  }

  .side-blurb {
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .side-list {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }

  /* ── Product picker rows ─────────────────────────────────────────────── */
  .pick {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    width: 100%;
    /* 44px tap target. */
    min-height: 3.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      border-color var(--dur-fast) var(--ease-out-soft);
  }

  .pick:hover {
    background: var(--color-page);
    border-color: var(--color-line-strong);
  }

  .pick-thumb {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border-radius: var(--radius-sm);
    background: var(--color-beige);
    overflow: hidden;
  }

  .pick-thumb :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pick-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .pick-name {
    font-size: var(--text-sm);
    font-weight: 700;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .pick-meta {
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  .pick-go {
    margin-left: auto;
    color: var(--color-ink-mute);
    flex: none;
    transition:
      transform var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }

  .pick:hover .pick-go {
    color: var(--color-orange);
    transform: translateX(3px);
  }
</style>
