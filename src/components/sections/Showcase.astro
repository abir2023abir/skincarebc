---
import { Image } from 'astro:assets';
import { site } from '~/config/site';
import { productImage, sceneImage } from '~/lib/images';
import { aggregateFor } from '~/lib/reviews';
import { formatBdt } from '~/lib/formatBdt';
import Stars from '~/components/ui/Stars.astro';
import Icon from '~/components/ui/Icon.astro';

/**
 * "Meet the brand" — the reference's filtered product carousel.
 *
 * The filter is a radio group, so switching lines costs zero JavaScript: the
 * checked radio drives `:has()` selectors that hide the non-matching cards.
 * Radios also give arrow-key navigation and a real accessible group for free,
 * which a div-with-click-handlers would not.
 */

const scenes = ['scene-1.jpg', 'scene-2.jpg', 'scene-3.jpg'] as const;

const filters = [
  { id: 'all', label: 'সব প্রোডাক্ট' },
  { id: 'her', label: 'For Her' },
  { id: 'him', label: 'For Him' },
] as const;

const items = site.products.map((p, i) => ({
  product: p,
  scene: scenes[i % scenes.length]!,
  rating: aggregateFor(p.id),
}));
---

<section class="section meet" id="showcase">
  <div class="wrap">
    <header class="head">
      <h2 class="title display">Meet The <span class="brand">{site.brandName}</span></h2>
      <p class="sub">
        চারটি প্রোডাক্ট, প্রতিটির পিছনে একটাই কারণ — নির্দিষ্ট একটা সমস্যার সমাধান।
      </p>
    </header>

    <div class="board" data-filter-board>
      <!-- ── Filter ─────────────────────────────────────────────────── -->
      <fieldset class="filter">
        <legend class="sr-only">প্রোডাক্ট লাইন বেছে নিন</legend>
        {
          filters.map((f, i) => (
            <span class="filter-item">
              <input
                type="radio"
                name="line-filter"
                id={`filter-${f.id}`}
                value={f.id}
                checked={i === 0}
                class="sr-only"
              />
              <label class="chip filter-chip" for={`filter-${f.id}`}>
                {f.label}
              </label>
            </span>
          ))
        }
      </fieldset>

      <!-- ── Rail ───────────────────────────────────────────────────── -->
      <ul class="rail" data-showcase-rail>
        {
          items.map(({ product, scene, rating }) => (
            <li class="cell" data-line={product.line}>
              <article class="scard">
                <div class="scene">
                  <Image
                    src={productImage(product.image)}
                    alt={product.imageAlt}
                    widths={[300, 600]}
                    sizes="(max-width: 48rem) 74vw, 300px"
                    loading="lazy"
                  />
                </div>

                <div class="scard-body">
                  <div class="scard-row">
                    <h3 class="scard-name en">{product.name}</h3>
                    <span class="scard-size en">{product.size}</span>
                  </div>

                  {rating.count > 0 && (
                    <p class="scard-rating">
                      <Stars rating={rating.average} />
                      <span>
                        {rating.average.toFixed(2)} · {rating.count} রিভিউ
                      </span>
                    </p>
                  )}

                  <p class="scard-benefit">{product.shortBenefit}</p>

                  <div class="scard-foot">
                    <span class="scard-price">{formatBdt(product.price)}</span>
                    <button
                      type="button"
                      class="scard-go"
                      data-order-open={product.id}
                      aria-label={`${product.name} অর্ডার করুন`}
                    >
                      <Icon name="arrow-right" size={18} />
                    </button>
                  </div>
                </div>
              </article>
            </li>
          ))
        }
        <li class="empty" aria-live="polite">এই লাইনে এখনো কোনো প্রোডাক্ট নেই।</li>
      </ul>
    </div>
  </div>
</section>

<style>
  .head {
    max-width: 42rem;
    margin-inline: auto;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    text-align: center;
  }

  .title {
    font-size: var(--text-4xl);
  }

  .brand {
    color: var(--color-orange);
  }

  .sub {
    max-width: 30rem;
    margin-inline: auto;
    margin-top: 0.9rem;
    color: var(--color-ink-soft);
  }

  .board {
    padding: clamp(1rem, 2.4vw, 1.75rem) 0 clamp(1.25rem, 2.4vw, 1.75rem);
    background: var(--color-card);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-card);
  }

  /* ── Filter ──────────────────────────────────────────────────────────── */
  .filter {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin: 0 0 clamp(1.25rem, 2.4vw, 1.75rem);
    padding: 0 var(--spacing-gutter);
    border: 0;
  }

  .filter-chip {
    cursor: pointer;
    /* 44px tap target. */
    min-height: 2.75rem;
    padding-inline: 1.1rem;
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }

  .filter-item:has(input:checked) .filter-chip {
    background: var(--color-ink);
    color: #fff;
  }

  /* The visually-hidden radio still owns the focus ring. */
  .filter-item:has(input:focus-visible) .filter-chip {
    outline: 2px solid var(--color-orange-deep);
    outline-offset: 3px;
  }

  /* ── Filtering, done entirely in CSS ─────────────────────────────────── */
  .empty {
    display: none;
    padding-inline: var(--spacing-gutter);
    color: var(--color-ink-mute);
    font-size: var(--text-sm);
  }

  .board:has(#filter-her:checked) .cell:not([data-line='her']),
  .board:has(#filter-him:checked) .cell:not([data-line='him']) {
    display: none;
  }

  /* Only surfaces if a filter genuinely matches nothing. */
  .board:has(#filter-her:checked):not(:has(.cell[data-line='her'])) .empty,
  .board:has(#filter-him:checked):not(:has(.cell[data-line='him'])) .empty {
    display: block;
  }

  /* ── Cards ───────────────────────────────────────────────────────────── */
  .cell {
    width: min(74vw, 19rem);
  }

  .scard {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-lg);
    background: var(--color-card);
    border: 1px solid var(--color-line);
    overflow: hidden;
  }

  .scene {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .scene :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out-soft);
  }

  @media (hover: hover) {
    .scard:hover .scene :global(img) {
      transform: scale(1.05);
    }
  }

  .scard-body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
    padding: 1rem 1.1rem 1.1rem;
  }

  .scard-row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .scard-name {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .scard-size {
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
    flex: none;
  }

  .scard-rating {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  .scard-benefit {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .scard-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.85rem;
  }

  .scard-price {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .scard-go {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      border-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }

  .scard-go:hover {
    background: var(--color-orange);
    border-color: var(--color-orange);
    color: #fff;
  }
</style>
