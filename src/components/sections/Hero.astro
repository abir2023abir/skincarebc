---
import { Image } from 'astro:assets';
import { site } from '~/config/site';
import { productImage, sceneImage } from '~/lib/images';
import Icon from '~/components/ui/Icon.astro';
import Button from '~/components/ui/Button.astro';
import OrderButton from '~/components/ui/OrderButton.astro';
import Botanical from '~/components/ui/Botanical.astro';

/**
 * Hero, matched to the reference: heavy headline on the left, a white "New
 * Arrival" product card in the middle, a beige model card on the right, with
 * botanical cut-outs scattered across the whole block.
 *
 * The one thing carried over from the original brief's 3D requirement: the
 * product card is a small 2.5D stage. hero-tilt.ts writes --tx/--ty onto it
 * from pointer or gyroscope input and each layer multiplies by its own --depth,
 * so the bottle, its shadow and the badge separate in space. Parallax falls out
 * of CSS; the JS is ~1.4 KB and the resting pose is already correct at first
 * paint, so the hero is complete without it.
 */

const hero = site.products[0]!;
const heroBottle = productImage(hero.image);
const modelHero = sceneImage('model-hero.png');
---

<section class="hero" id="top">
  <div class="wrap">
    <div class="panel hero-panel">
      {/* Scatter is deliberately off the panel's corners and away from every
          control — nothing decorative may sit over a tap target. */}
      <Botanical file="sprig-dried.png" size={130} top="3%" left="-3.5%" rotate="-14deg" />
      <Botanical file="sunflower.png" size={104} bottom="4%" right="31.5%" rotate="12deg" />
      <Botanical file="leaf-autumn.png" size={92} bottom="-5%" right="-2.5%" rotate="-24deg" />
      <Botanical file="sprig-green.png" size={96} top="-4%" right="16%" rotate="18deg" />

      <div class="hero-grid">
        <!-- ── Copy ─────────────────────────────────────────────────── -->
        <div class="copy">
          <p class="eyebrow">{site.hero.eyebrow}</p>

          <h1 class="headline">
            {site.hero.headline.map((line) => <span class="line">{line}</span>)}
          </h1>

          <p class="promise">{site.hero.promise}</p>

          <div class="actions">
            <OrderButton magnetic label="অর্ডার করুন" />

            <a class="watch" href="#reviews">
              <span class="btn-round" aria-hidden="true"><Icon name="play" size={18} /></span>
              <span>রিভিউ দেখুন</span>
            </a>
          </div>
        </div>

        <!-- ── Product card (2.5D stage) ────────────────────────────── -->
        <div class="promo" data-hero-stage>
          <p class="promo-badge">
            <span>নতুন</span>
            <span>প্রোডাক্ট</span>
          </p>

          <div class="promo-art">
            <div class="depth" style="--depth: 0.3">
              <span class="promo-shadow" aria-hidden="true"></span>
            </div>
            <div class="depth" style="--depth: 1.4">
              <Image
                src={heroBottle}
                alt={hero.imageAlt}
                widths={[220, 440]}
                sizes="(max-width: 60rem) 40vw, 220px"
                loading="eager"
                fetchpriority="high"
              />
            </div>
          </div>

          <p class="promo-name en">{hero.name}</p>
        </div>

        <!-- ── Model card ───────────────────────────────────────────── -->
        <div class="model">
          <Image
            src={modelHero}
            alt="একজন নারী গালে ময়েশ্চারাইজার লাগাচ্ছেন"
            widths={[320, 560, 780]}
            sizes="(max-width: 60rem) 80vw, 32vw"
            loading="eager"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(5.5rem, 10vh, 7rem);
  }

  .hero-panel {
    position: relative;
    padding: clamp(1.5rem, 4vw, 3.25rem);
    /* Botanicals hang past the panel edge. */
    overflow: visible;
  }

  /* Asymmetric three-part split: copy takes the most room, the promo card is
     narrow, the model card closes the row. Never a centred headline. */
  .hero-grid {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: center;
  }

  @media (min-width: 62rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 1.38fr) minmax(0, 0.7fr) minmax(0, 0.95fr);
    }
  }

  /* ── Copy ────────────────────────────────────────────────────────────── */
  .copy {
    position: relative;
    z-index: 4;
  }

  .headline {
    margin-top: 1rem;
    font-family: var(--font-bn);
    /* Its own scale, not --text-5xl: Bangla conjuncts set wider than Latin and
       need more leading than a heavy Latin display line. */
    font-size: clamp(2.1rem, 3.6vw, 3.1rem);
    font-weight: 700;
    line-height: 1.16;
    letter-spacing: -0.02em;
  }

  .line {
    display: block;
  }

  .line:last-child {
    color: var(--color-orange-deep);
  }

  .promise {
    margin-top: 1.25rem;
    max-width: 26rem;
    color: var(--color-ink-soft);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.25rem;
    margin-top: clamp(1.5rem, 3vw, 2.25rem);
  }

  .watch {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink);
    /* Keeps the whole control at the 44px tap-target floor. */
    min-height: 2.75rem;
  }

  .watch .btn-round {
    transition: transform var(--dur-fast) var(--ease-out-soft);
  }

  .watch:hover .btn-round {
    transform: scale(1.08);
    background: var(--color-orange);
  }

  /* ── Promo card ──────────────────────────────────────────────────────── */
  .promo {
    position: relative;
    z-index: 3;
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 1.5rem 1.25rem 1.25rem;
    border: 1.5px solid var(--color-ink);
    border-radius: 9rem 9rem var(--radius-lg) var(--radius-lg);
    background: var(--color-card);
    /* Written by hero-tilt.ts; the resting pose is 0, so this is correct
       before — and entirely without — JavaScript. */
    --tx: 0;
    --ty: 0;
    perspective: 900px;
  }

  .promo-badge {
    display: grid;
    justify-items: center;
    font-family: var(--font-bn);
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
  }

  .promo-art {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1 / 1.25;
    transform-style: preserve-3d;
  }

  .depth {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    /* Depth parallax — transform only, never layout. */
    transform: translate3d(
        calc(var(--tx) * var(--depth) * 1px),
        calc(var(--ty) * var(--depth) * 1px),
        0
      )
      rotateY(calc(var(--tx) * var(--depth) * 0.05deg))
      rotateX(calc(var(--ty) * var(--depth) * -0.05deg));
    transition: transform 650ms var(--ease-out-soft);
  }

  /* Once the pointer is live, drop the easing so the tilt tracks the cursor. */
  .promo[data-live] .depth {
    transition: none;
  }

  .promo-art :global(img) {
    width: 62%;
    height: auto;
  }

  .promo-shadow {
    width: 62%;
    height: 14%;
    align-self: end;
    margin-bottom: 4%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(19 19 19 / 0.28), transparent);
  }

  .promo-name {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink-mute);
    text-align: center;
  }

  /* ── Model card ──────────────────────────────────────────────────────── */
  .model {
    position: relative;
    z-index: 2;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .model :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  /* On phones the promo card sits beside the model card rather than stacking
     into two tall blocks. */
  @media (max-width: 62rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }

    .copy {
      grid-column: 1 / -1;
    }

    .model :global(img) {
      aspect-ratio: 3 / 4;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .depth {
      transform: none;
      transition: none;
    }
  }
</style>
