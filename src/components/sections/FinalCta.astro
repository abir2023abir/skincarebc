---
import { Image } from 'astro:assets';
import { site } from '~/config/site';
import { productImage } from '~/lib/images';
import OrderButton from '~/components/ui/OrderButton.astro';
import Botanical from '~/components/ui/Botanical.astro';

/**
 * Closing band, built on the reference's big ghost-display-text moment: an
 * oversized outlined wordmark behind a large tilted bottle.
 *
 * The ghost text is aria-hidden — it is texture, not a heading, and a screen
 * reader announcing "MORE SKINCARE NATURAL BEAUTY" between the real headline
 * and the CTA would be noise.
 */

const hero = site.products[0]!;
---

<section class="section final">
  <Botanical file="sprig-green.png" size={110} top="6%" left="2%" rotate="-20deg" />
  <Botanical file="anemone.png" size={88} bottom="16%" right="3%" rotate="14deg" />

  <p class="ghost display" aria-hidden="true">
    <span>MORE SKINCARE</span>
    <span>NATURAL BEAUTY</span>
  </p>

  <div class="wrap grid">
    <div class="copy">
      <h2 class="title">
        {site.closing.headline.map((line) => <span class="line">{line}</span>)}
      </h2>

      <p class="body">{site.closing.body}</p>

      <div class="actions">
        <OrderButton magnetic label="অর্ডার করুন" />
      </div>

      <p class="meta">
        ডেলিভারি চার্জ — রাজশাহীর ভিতরে ৳{site.deliveryCharge.insideRajshahi}, বাইরে ৳{
          site.deliveryCharge.outsideRajshahi
        }
      </p>
    </div>

    <div class="art">
      <Image
        src={productImage(hero.image)}
        alt=""
        aria-hidden="true"
        widths={[260, 520]}
        sizes="(max-width: 60rem) 52vw, 300px"
        loading="lazy"
      />
    </div>
  </div>
</section>

<style>
  .final {
    position: relative;
    overflow: clip;
  }

  /* ── Ghost text ──────────────────────────────────────────────────────── */
  .ghost {
    position: absolute;
    inset: auto 0 6%;
    display: grid;
    gap: 0.02em;
    text-align: center;
    font-size: var(--text-ghost);
    line-height: 0.92;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px color-mix(in oklab, var(--color-ink) 16%, transparent);
    user-select: none;
    pointer-events: none;
    white-space: nowrap;
  }

  /* Safari and Firefox both support -webkit-text-stroke, but fall back to a
     faint fill anywhere it is missing so the band is never blank. */
  @supports not (-webkit-text-stroke: 1px red) {
    .ghost {
      color: color-mix(in oklab, var(--color-ink) 8%, transparent);
    }
  }

  /* ── Layout ──────────────────────────────────────────────────────────── */
  .grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.8fr);
    }
  }

  .title {
    font-family: var(--font-bn);
    font-size: clamp(2rem, 3.4vw, 3rem);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.02em;
  }

  .line {
    display: block;
  }

  .line:last-child {
    color: var(--color-orange-deep);
  }

  .body {
    margin-top: 1.1rem;
    max-width: 28rem;
    color: var(--color-ink-soft);
  }

  .actions {
    margin-top: clamp(1.5rem, 3vw, 2rem);
  }

  .meta {
    margin-top: 1rem;
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  /* ── Bottle ──────────────────────────────────────────────────────────── */
  .art {
    display: grid;
    place-items: center;
  }

  .art :global(img) {
    width: min(74%, 17rem);
    height: auto;
    rotate: 14deg;
    filter: drop-shadow(0 40px 44px rgb(19 19 19 / 0.26));
  }

  @media (max-width: 60rem) {
    .ghost {
      inset: auto 0 2%;
      font-size: clamp(2.5rem, 13vw, 5rem);
    }
  }
</style>
