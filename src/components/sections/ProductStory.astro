---
import { Image } from 'astro:assets';
import { site } from '~/config/site';
import { productImage } from '~/lib/images';
import { formatBdt } from '~/lib/formatBdt';
import { savingsPercent } from '~/lib/pricing';
import OrderButton from '~/components/ui/OrderButton.astro';
import Botanical from '~/components/ui/Botanical.astro';
import Icon from '~/components/ui/Icon.astro';

/**
 * One scroll-driven feature moment per product (brief §4).
 *
 * Each row is a panel with a sticky image well on one side — sides alternate —
 * and the ingredients and directions beside it. motion/scroll.ts attaches a
 * ScrollTrigger per row that drives --p from 0 to 1 across the row's travel;
 * the bottle reads --p to rotate, scale and lift, and the detail blocks stagger
 * in. Everything is transform/opacity.
 *
 * Without JavaScript --p simply stays 0, which is the resting pose: the bottle
 * sits upright, every block is visible, nothing is hidden behind an animation.
 */

const tones = ['beige', 'sage', 'sand', 'beige'] as const;
---

<section class="stories" id="story">
  {
    site.products.map((product, i) => {
      const saved = savingsPercent(product.price, product.oldPrice);
      return (
        <div class="wrap">
          <article
            class:list={['story', 'panel', i % 2 === 1 && 'story-flip']}
            data-story
            id={`story-${product.id}`}
          >
            {i === 0 && (
              <Botanical file="sprig-green.png" size={88} top="-6%" right="4%" rotate="-18deg" />
            )}
            {i === 2 && (
              <Botanical file="rose.png" size={84} bottom="-5%" left="3%" rotate="12deg" />
            )}

            {/* ── Sticky product well ──────────────────────────────── */}
            <div class:list={['well', `tone-${tones[i % tones.length]}`]}>
              <p class="index display" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>

              <div class="bottle" data-story-bottle>
                <Image
                  src={productImage(product.image)}
                  alt={product.imageAlt}
                  widths={[260, 520]}
                  sizes="(max-width: 60rem) 52vw, 300px"
                  loading="lazy"
                />
              </div>
            </div>

            {/* ── Detail ───────────────────────────────────────────── */}
            <div class="detail">
              <p class="eyebrow">
                {product.line === 'her' ? 'For Her' : product.line === 'him' ? 'For Him' : 'For All'}
                {' · '}
                {product.size}
              </p>

              <h2 class="name en" data-story-item>{product.name}</h2>
              <p class="benefit" data-story-item>{product.shortBenefit}</p>
              <p class="desc" data-story-item>{product.description}</p>

              <div class="block" data-story-item>
                <h3 class="block-title">মূল উপাদান</h3>
                <ul class="ings">
                  {product.keyIngredients.map((ing) => (
                    <li class="ing en">{ing}</li>
                  ))}
                </ul>
              </div>

              <div class="block" data-story-item>
                <h3 class="block-title">কীভাবে ব্যবহার করবেন</h3>
                <ol class="steps">
                  {product.howToUse.map((step, s) => (
                    <li>
                      <span class="step-num" aria-hidden="true">{s + 1}</span>
                      <span>{step}</span>
                    </li>
                  ))}
                </ol>
              </div>

              <div class="buy" data-story-item>
                <p class="price">
                  <span class="now">{formatBdt(product.price)}</span>
                  {product.oldPrice && product.oldPrice > product.price && (
                    <>
                      <s class="was">
                        {formatBdt(product.oldPrice)}
                        <span class="sr-only">— আগের দাম</span>
                      </s>
                      <span class="saved">{saved}% ছাড়</span>
                    </>
                  )}
                </p>

                <OrderButton itemId={product.id} magnetic label="অর্ডার করুন" />
              </div>

              <p class="note">
                <Icon name="shield" size={16} />
                <span>ব্যাচ নম্বর ও মেয়াদসহ পাঠানো হয়</span>
              </p>
            </div>
          </article>
        </div>
      );
    })
  }
</section>

<style>
  .stories {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    padding-block: var(--spacing-section);
  }

  .story {
    position: relative;
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding: clamp(1.25rem, 3vw, 2.25rem);
    overflow: visible;
  }

  @media (min-width: 60rem) {
    .story {
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
      align-items: start;
    }

    /* Alternating sides — the grid order flips, the DOM order does not, so
       reading order stays image-then-detail for a screen reader. */
    .story-flip .well {
      order: 2;
    }
  }

  /* ── Product well ────────────────────────────────────────────────────── */
  .well {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1.05;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  @media (min-width: 60rem) {
    .well {
      position: sticky;
      /* Clears the floating header. */
      top: 6rem;
    }
  }

  .tone-beige {
    background: var(--color-beige);
  }

  .tone-sage {
    background: #d8e0d2;
  }

  .tone-sand {
    background: var(--color-beige-deep);
  }

  /* Oversized editorial numeral behind the bottle. */
  .index {
    position: absolute;
    top: 0.2em;
    left: 0.12em;
    font-size: var(--text-ghost);
    line-height: 1;
    color: color-mix(in oklab, var(--color-ink) 8%, transparent);
    user-select: none;
  }

  .bottle {
    position: relative;
    width: 58%;
    /* --p is written by motion/scroll.ts, 0 → 1 across the row. Absent JS it
       stays 0 and the bottle rests upright. */
    --p: 0;
    transform: rotate(calc((var(--p) - 0.5) * 14deg))
      scale(calc(0.94 + var(--p) * 0.12))
      translateY(calc((0.5 - var(--p)) * 18px));
    filter: drop-shadow(0 26px 30px rgb(19 19 19 / 0.22));
  }

  .bottle :global(img) {
    width: 100%;
    height: auto;
  }

  /* ── Detail column ───────────────────────────────────────────────────── */
  .detail {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    min-width: 0;
  }

  .name {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .benefit {
    font-size: var(--text-lg);
    color: var(--color-ink);
  }

  .desc {
    color: var(--color-ink-soft);
  }

  .block {
    padding-top: 0.9rem;
    border-top: 1px solid var(--color-line);
  }

  .block-title {
    margin-bottom: 0.6rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .ings {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .ing {
    padding: 0.35rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--color-page);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .steps {
    display: grid;
    gap: 0.55rem;
  }

  .steps li {
    display: flex;
    gap: 0.7rem;
    font-size: var(--text-sm);
    color: var(--color-ink-soft);
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    flex: none;
    margin-top: 0.15rem;
    border-radius: var(--radius-pill);
    background: var(--color-ink);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.625rem;
    font-weight: 800;
  }

  /* ── Buy row ─────────────────────────────────────────────────────────── */
  .buy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-line);
  }

  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-family: var(--font-display);
  }

  .now {
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .was {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-ink-mute);
  }

  .saved {
    font-family: var(--font-bn);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--color-orange-deep);
  }

  .note {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  .note :global(svg) {
    color: var(--color-green);
    flex: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .bottle {
      transform: none;
    }
  }
</style>
