---
import { site, productById } from '~/config/site';
import Icon from '~/components/ui/Icon.astro';
import Botanical from '~/components/ui/Botanical.astro';

/**
 * Ingredient explorer.
 *
 * Radio-driven, so it works with zero JavaScript and gets arrow-key navigation,
 * a real group label and correct checked-state semantics for free. Every detail
 * panel is in the DOM; `:has()` on the checked radio reveals one at a time,
 * and the panels are stacked in a grid cell so switching never changes height.
 */
---

<section class="section ingredients" id="ingredients">
  <Botanical file="sprig-green.png" size={104} top="8%" right="1%" rotate="24deg" />

  <div class="wrap">
    <header class="head">
      <p class="eyebrow">উপাদান</p>
      <h2 class="title">
        <span class="display">What's inside</span>, আর কেন
      </h2>
      <p class="sub">
        নাম শুনে ভয় পাওয়ার কিছু নেই। প্রতিটি উপাদান কী করে, সহজ বাংলায় লেখা আছে।
      </p>
    </header>

    <div class="explorer panel" data-explorer>
      <fieldset class="list">
        <legend class="sr-only">একটি উপাদান বেছে নিন</legend>
        {
          site.ingredients.map((ing, i) => (
            <span class="list-item">
              <input
                type="radio"
                name="ingredient"
                id={`ing-${ing.id}`}
                checked={i === 0}
                class="sr-only"
              />
              <label class="list-label" for={`ing-${ing.id}`}>
                <span class="list-num display" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="list-text">
                  <span class="list-name en">{ing.name}</span>
                  <span class="list-role">{ing.role}</span>
                </span>
                <span class="list-go" aria-hidden="true">
                  <Icon name="arrow-right" size={16} />
                </span>
              </label>
            </span>
          ))
        }
      </fieldset>

      <div class="stage">
        {
          site.ingredients.map((ing) => (
            <article class="detail" data-for={ing.id}>
              <p class="detail-role">{ing.role}</p>
              <h3 class="detail-name en display">{ing.name}</h3>
              <p class="detail-body">{ing.explainer}</p>

              <div class="detail-in">
                <p class="detail-label">যেসব প্রোডাক্টে আছে</p>
                <ul class="detail-links">
                  {ing.productIds.map((pid) => {
                    const p = productById(pid);
                    return p ? (
                      <li>
                        <button type="button" class="detail-link" data-order-open={p.id}>
                          <span class="en">{p.name}</span>
                          <Icon name="arrow-up-right" size={14} />
                        </button>
                      </li>
                    ) : null;
                  })}
                </ul>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .ingredients {
    position: relative;
    overflow-x: clip;
  }

  .head {
    max-width: 40rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .title {
    margin-top: 0.75rem;
    font-size: var(--text-4xl);
  }

  .sub {
    margin-top: 0.9rem;
    max-width: 30rem;
    color: var(--color-ink-soft);
  }

  /* ── Explorer frame ──────────────────────────────────────────────────── */
  .explorer {
    display: grid;
    gap: 0;
    overflow: hidden;
  }

  @media (min-width: 60rem) {
    .explorer {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  /* ── List ────────────────────────────────────────────────────────────── */
  .list {
    display: grid;
    margin: 0;
    padding: clamp(0.75rem, 1.6vw, 1.25rem);
    border: 0;
  }

  .list-label {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    /* 44px tap target. */
    min-height: 3.75rem;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease-out-soft);
  }

  .list-label:hover {
    background: var(--color-page);
  }

  .list-item:has(input:checked) .list-label {
    background: var(--color-ink);
    color: #fff;
  }

  .list-item:has(input:focus-visible) .list-label {
    outline: 2px solid var(--color-orange-deep);
    outline-offset: -2px;
  }

  .list-num {
    font-size: var(--text-sm);
    color: var(--color-ink-mute);
    font-variant-numeric: tabular-nums;
    flex: none;
  }

  .list-item:has(input:checked) .list-num {
    color: var(--color-orange-bright);
  }

  .list-text {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
  }

  .list-name {
    font-size: var(--text-base);
    font-weight: 700;
  }

  .list-role {
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  .list-item:has(input:checked) .list-role {
    color: color-mix(in oklab, #fff 70%, transparent);
  }

  .list-go {
    margin-left: auto;
    flex: none;
    opacity: 0;
    transition:
      opacity var(--dur-fast) var(--ease-out-soft),
      transform var(--dur-fast) var(--ease-out-soft);
  }

  .list-label:hover .list-go,
  .list-item:has(input:checked) .list-go {
    opacity: 1;
    transform: translateX(2px);
  }

  /* ── Detail stage ────────────────────────────────────────────────────── */
  .stage {
    display: grid;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--color-page);
  }

  /* Every panel occupies the same cell, so the height never jumps. */
  .detail {
    grid-area: 1 / 1;
    opacity: 0;
    visibility: hidden;
    translate: 0 0.75rem;
    transition:
      opacity var(--dur-base) var(--ease-out-soft),
      translate var(--dur-base) var(--ease-out-soft),
      visibility var(--dur-base);
  }

  .explorer:has(#ing-niacinamide:checked) .detail[data-for='niacinamide'],
  .explorer:has(#ing-hyaluronic-acid:checked) .detail[data-for='hyaluronic-acid'],
  .explorer:has(#ing-vitamin-c:checked) .detail[data-for='vitamin-c'],
  .explorer:has(#ing-centella:checked) .detail[data-for='centella'],
  .explorer:has(#ing-salicylic-acid:checked) .detail[data-for='salicylic-acid'] {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
  }

  .detail-role {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-orange-deep);
  }

  .detail-name {
    margin-top: 0.5rem;
    font-size: var(--text-3xl);
  }

  .detail-body {
    margin-top: 0.9rem;
    max-width: 30rem;
    color: var(--color-ink-soft);
  }

  .detail-in {
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-line);
  }

  .detail-label {
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }

  .detail-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.7rem;
  }

  .detail-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    /* 44px tap target. */
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: var(--color-card);
    font-size: var(--text-sm);
    font-weight: 700;
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      border-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }

  .detail-link:hover {
    background: var(--color-orange);
    border-color: var(--color-orange);
    color: #fff;
  }
</style>
