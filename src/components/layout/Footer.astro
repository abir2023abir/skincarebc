---
import { site } from '~/config/site';
import Icon from '~/components/ui/Icon.astro';

const year = new Date().getFullYear();
const waHref = `https://wa.me/${site.whatsappNumber.replace(/\D/g, '')}`;
const telHref = `tel:+88${site.phone.replace(/\D/g, '')}`;
---

<footer class="foot on-dark">
  <div class="wrap">
    <div class="top">
      <div class="brand">
        <p class="mark">
          <span class="mark-dot" aria-hidden="true"></span>
          <span class="display">{site.brandName}</span>
        </p>
        <p class="tagline">{site.tagline}</p>
      </div>

      <nav class="links" aria-label="ফুটার">
        <div class="col">
          <h2 class="col-title">প্রোডাক্ট</h2>
          <a href="#for-her">For Her</a>
          <a href="#for-him">For Him</a>
          <a href="#combos">কম্বো অফার</a>
          <a href="#ingredients">উপাদান</a>
        </div>

        <div class="col">
          <h2 class="col-title">সাহায্য</h2>
          <a href="#how-to-order">কীভাবে অর্ডার করবেন</a>
          <a href="#faq">সাধারণ প্রশ্ন</a>
          <a href="#reviews">রিভিউ</a>
        </div>

        <div class="col">
          <h2 class="col-title">যোগাযোগ</h2>
          <a href={waHref} target="_blank" rel="noopener noreferrer">
            <Icon name="chat" size={15} />
            <span>WhatsApp</span>
          </a>
          <a href={telHref}>
            <Icon name="phone" size={15} />
            <span>{site.phone}</span>
          </a>
          <a href={site.facebookPage} target="_blank" rel="noopener noreferrer">
            <Icon name="facebook" size={15} />
            <span>Facebook</span>
          </a>
          <p class="addr">
            <Icon name="pin" size={15} />
            <span>{site.address}</span>
          </p>
        </div>
      </nav>
    </div>

    <hr class="hairline" />

    <div class="policies">
      <div class="policy">
        <h2 class="policy-title">ডেলিভারি</h2>
        <p>{site.policies.delivery}</p>
      </div>
      <div class="policy">
        <h2 class="policy-title">ফেরত ও বদল</h2>
        <p>{site.policies.returns}</p>
      </div>
      <div class="policy">
        <h2 class="policy-title">আসল পণ্যের নিশ্চয়তা</h2>
        <p>{site.policies.authenticity}</p>
      </div>
    </div>

    <hr class="hairline" />

    <div class="base">
      <p>© {year} {site.brandName}। সর্বস্বত্ব সংরক্ষিত।</p>
      <p class="disclaimer">
        এই পণ্যগুলো প্রসাধনী, ওষুধ নয়। ত্বকের কোনো রোগ থাকলে চিকিৎসকের পরামর্শ নিন।
      </p>
    </div>
  </div>
</footer>

<style>
  .foot {
    /* Room for the fixed mobile order bar. */
    padding-block: clamp(2.5rem, 5vw, 4.5rem) calc(clamp(2rem, 4vw, 3rem) + var(--mobile-bar, 0px));
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  /* ── Top ─────────────────────────────────────────────────────────────── */
  .top {
    display: grid;
    gap: clamp(1.75rem, 4vw, 3rem);
  }

  @media (min-width: 52rem) {
    .top {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
    }
  }

  .mark {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xl);
  }

  .mark-dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-orange-bright);
    flex: none;
  }

  .tagline {
    margin-top: 0.75rem;
    max-width: 20rem;
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-page) 68%, transparent);
  }

  /* ── Link columns ────────────────────────────────────────────────────── */
  .links {
    display: grid;
    gap: 1.75rem;
  }

  @media (min-width: 34rem) {
    .links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .col {
    display: grid;
    gap: 0.15rem;
    align-content: start;
  }

  .col-title {
    margin-bottom: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-orange-bright);
  }

  .col a,
  .addr {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    /* 44px tap target. */
    min-height: 2.75rem;
    font-size: var(--text-sm);
    color: color-mix(in oklab, var(--color-page) 82%, transparent);
    transition: color var(--dur-fast) var(--ease-out-soft);
  }

  .col a:hover {
    color: #fff;
  }

  .col :global(svg) {
    flex: none;
    opacity: 0.7;
  }

  .addr {
    align-items: start;
    min-height: 0;
    padding-block: 0.65rem;
    line-height: 1.6;
  }

  .addr :global(svg) {
    margin-top: 0.2rem;
  }

  /* ── Policies ────────────────────────────────────────────────────────── */
  .policies {
    display: grid;
    gap: 1.5rem;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
  }

  @media (min-width: 52rem) {
    .policies {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .policy-title {
    margin-bottom: 0.45rem;
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .policy p {
    font-size: var(--text-xs);
    line-height: 1.75;
    color: color-mix(in oklab, var(--color-page) 66%, transparent);
  }

  /* ── Base ────────────────────────────────────────────────────────────── */
  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    font-size: var(--text-xs);
    color: color-mix(in oklab, var(--color-page) 60%, transparent);
  }

  .disclaimer {
    max-width: 34rem;
  }
</style>
