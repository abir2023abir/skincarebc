---
/**
 * The whole icon set. Hand-drawn line icons on a 24×24 grid with a single
 * 1.5 stroke, round caps and round joins — no icon library, no emoji.
 *
 * Icons are inlined rather than sprited: there are ~18 of them, they gzip to
 * almost nothing inside the HTML, and inlining avoids a second request and the
 * <use> focus quirks in older Android WebViews.
 */

export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-down'
  | 'check'
  | 'copy'
  | 'close'
  | 'plus'
  | 'minus'
  | 'chevron'
  | 'truck'
  | 'shield'
  | 'wallet'
  | 'chat'
  | 'phone'
  | 'pin'
  | 'star'
  | 'spark'
  | 'droplet'
  | 'leaf'
  | 'flask'
  | 'facebook'
  | 'camera'
  | 'bag'
  | 'play'
  | 'face';

interface Props {
  name: IconName;
  size?: number;
  class?: string;
  /** Icons are decorative by default; pass a label to expose one to a reader. */
  label?: string;
}

const { name, size = 20, class: className = '', label } = Astro.props;

/** Raw inner markup per icon, so a glyph can use rects and circles too. */
const glyphs: Record<IconName, string> = {
  'arrow-right': '<path d="M4 12h15M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8.5 7H17v8.5"/>',
  'arrow-down': '<path d="M12 4v15M6 13l6 6 6-6"/>',
  check: '<path d="m4.5 12.5 5 5L19.5 6.5"/>',
  copy: '<rect x="8.5" y="8.5" width="11.5" height="11.5" rx="2.5"/><path d="M15.5 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v7.5a2 2 0 0 0 2 2h2"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  plus: '<path d="M12 5.5v13M5.5 12h13"/>',
  minus: '<path d="M5.5 12h13"/>',
  chevron: '<path d="m6 9.5 6 6 6-6"/>',
  truck:
    '<path d="M2.5 6.5h11v10h-11z"/><path d="M13.5 10h4l4 3.5v3h-8z"/><circle cx="7" cy="18.5" r="2"/><circle cx="17" cy="18.5" r="2"/>',
  shield:
    '<path d="M12 3.2 4.8 6v6c0 4.2 2.9 7.4 7.2 8.8 4.3-1.4 7.2-4.6 7.2-8.8V6z"/><path d="m9 12 2.2 2.2L15.4 10"/>',
  wallet:
    '<rect x="3" y="6" width="18" height="13" rx="3"/><path d="M3 10.5h18"/><circle cx="16.5" cy="15" r="1.2"/>',
  // Deliberately not the WhatsApp mark — a custom handset-in-bubble glyph that
  // matches the rest of the set and sidesteps the trademark. See README.
  chat: '<path d="M20.5 11.6c0 4.3-3.8 7.7-8.5 7.7-1.2 0-2.4-.2-3.4-.6l-5.1 1.6 1.7-4.5a7.2 7.2 0 0 1-1.7-4.6c0-4.2 3.8-7.6 8.5-7.6s8.5 3.4 8.5 7.6z"/><path d="M9.3 9.2c.4 2 2 3.5 3.9 3.9l.9-1.2 1.8.8-.4 1.6c-2.9.5-6-2.3-6.6-5.2l1.6-.4z"/>',
  phone:
    '<path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2C11.4 19 5 12.6 4.5 5.7a2 2 0 0 1 2-2.2z"/>',
  pin: '<path d="M12 21s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11z"/><circle cx="12" cy="10" r="2.6"/>',
  star: '<path d="m12 3.6 2.6 5.3 5.9.9-4.3 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8L3.5 9.8l5.9-.9z" fill="currentColor" stroke="none"/>',
  spark:
    '<path d="M12 3.5 13.8 9 19.5 12 13.8 15 12 20.5 10.2 15 4.5 12 10.2 9z"/><path d="M18.5 4.5v3M17 6h3"/>',
  droplet: '<path d="M12 3.5c3.4 4 5.5 6.6 5.5 9.4a5.5 5.5 0 1 1-11 0c0-2.8 2.1-5.4 5.5-9.4z"/>',
  leaf: '<path d="M20 4.5C10.5 4 4.5 8 4.5 14.5A5.5 5.5 0 0 0 10 20c6.5 0 10.5-6 10-15.5z"/><path d="M4.5 20C8 16 12.5 12 18 9.5"/>',
  flask:
    '<path d="M9.5 3.5h5M10.5 3.5v6L5.8 17.4A2.5 2.5 0 0 0 8 21.2h8a2.5 2.5 0 0 0 2.2-3.8L13.5 9.5v-6"/><path d="M7.6 14.5h8.8"/>',
  facebook:
    '<path d="M14.2 21v-7.6h2.6l.4-3h-3V8.5c0-.9.2-1.5 1.5-1.5h1.6V4.3c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v2.1H8.3v3h2.6V21z" fill="currentColor" stroke="none"/>',
  camera:
    '<rect x="3" y="7" width="18" height="13" rx="3"/><path d="M9 7l1.3-2.5h3.4L15 7"/><circle cx="12" cy="13.5" r="3.4"/>',
  bag: '<path d="M5 8h14l1 11.5a2 2 0 0 1-2 2.2H6a2 2 0 0 1-2-2.2z"/><path d="M8.8 10.5V6.8a3.2 3.2 0 0 1 6.4 0v3.7"/>',
  play: '<path d="M9.4 7.6 17 12l-7.6 4.4z" fill="currentColor" stroke="none"/>',
  face: '<circle cx="12" cy="12" r="8.6"/><path d="M9 10.4h.01M15 10.4h.01" stroke-width="2.2"/><path d="M8.9 14.6a4.2 4.2 0 0 0 6.2 0"/>',
};

const hidden = label ? undefined : 'true';
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={hidden}
  role={label ? 'img' : undefined}
  focusable="false"
>
  {label && <title>{label}</title>}
  <Fragment set:html={glyphs[name]} />
</svg>
