---
import { Image } from 'astro:assets';
import type { Product } from '~/config/site';
import { productImage } from '~/lib/images';
import { aggregateFor } from '~/lib/reviews';
import { formatBdt } from '~/lib/formatBdt';
import Stars from './Stars.astro';
import Icon from './Icon.astro';

/**
 * Product card, matched to the reference: a tinted image well on top, then the
 * name and size on one row, rating, a one-line benefit, and price opposite a
 * round order button.
 *
 * The whole card is one link-like surface but only the button is interactive,
 * so there is exactly one tab stop per card and no nested controls.
 */
interface Props {
  product: Product;
  /** Tints the image well; lets a row of cards vary like the reference. */
  tone?: 'beige' | 'sage' | 'sand';
  class?: string;
}

const { product, tone = 'beige', class: className = '' } = Astro.props;
const image = productImage(product.image);
const rating = aggregateFor(product.id);
---

<article class:list={['pcard', 'card', className]} id={product.id}>
  <div class:list={['well', `tone-${tone}`]}>
    {product.badge && <p class="badge">{product.badge}</p>}
    <Image
      src={image}
      alt={product.imageAlt}
      widths={[200, 400]}
      sizes="(max-width: 48rem) 45vw, 240px"
      loading="lazy"
    />
  </div>

  <div class="body">
    <div class="row">
      <h3 class="name en">{product.name}</h3>
      <span class="size en">{product.size}</span>
    </div>

    {
      rating.count > 0 && (
        <p class="rating">
          <Stars rating={rating.average} />
          <span>
            {rating.average.toFixed(2)} · {rating.count} রিভিউ
          </span>
        </p>
      )
    }

    <p class="benefit">{product.shortBenefit}</p>

    <div class="foot">
      <p class="price">
        <span class="now">{formatBdt(product.price)}</span>
        {
          product.oldPrice && product.oldPrice > product.price && (
            <s class="was">
              {formatBdt(product.oldPrice)}
              <span class="sr-only">— আগের দাম</span>
            </s>
          )
        }
      </p>

      <button
        type="button"
        class="go"
        data-order-open={product.id}
        aria-label={`${product.name} অর্ডার করুন`}
      >
        <Icon name="arrow-right" size={18} />
      </button>
    </div>
  </div>
</article>

<style>
  .pcard {
    display: flex;
    flex-direction: column;
    padding: 0.75rem 0.75rem 1.1rem;
    transition:
      transform var(--dur-base) var(--ease-out-soft),
      box-shadow var(--dur-base) var(--ease-out-soft);
  }

  @media (hover: hover) {
    .pcard:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-float);
    }
  }

  /* ── Image well ──────────────────────────────────────────────────────── */
  .well {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .tone-beige {
    background: var(--color-beige);
  }

  .tone-sage {
    background: #d8e0d2;
  }

  .tone-sand {
    background: var(--color-beige-deep);
  }

  .well :global(img) {
    width: 56%;
    height: auto;
    transition: transform var(--dur-slow) var(--ease-out-soft);
  }

  @media (hover: hover) {
    .pcard:hover .well :global(img) {
      transform: scale(1.06) rotate(-2deg);
    }
  }

  .badge {
    position: absolute;
    top: 0.65rem;
    left: 0.65rem;
    z-index: 2;
  }

  /* ── Body ────────────────────────────────────────────────────────────── */
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    flex: 1;
    padding: 0.9rem 0.5rem 0;
  }

  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .name {
    font-size: var(--text-base);
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .size {
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
    flex: none;
  }

  .rating {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: var(--text-xs);
    color: var(--color-ink-mute);
  }

  .benefit {
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--color-ink-soft);
  }

  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 0.9rem;
  }

  .price {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    font-family: var(--font-display);
  }

  .now {
    font-size: var(--text-lg);
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .was {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-ink-mute);
  }

  .go {
    display: grid;
    place-items: center;
    /* 44px tap target. */
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    transition:
      background-color var(--dur-fast) var(--ease-out-soft),
      border-color var(--dur-fast) var(--ease-out-soft),
      color var(--dur-fast) var(--ease-out-soft);
  }

  .go:hover {
    background: var(--color-orange);
    border-color: var(--color-orange);
    color: #fff;
  }
</style>
