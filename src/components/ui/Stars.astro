---
import Icon from './Icon.astro';

interface Props {
  rating: number;
  class?: string;
}

const { rating, class: className = '' } = Astro.props;
const filled = Math.max(0, Math.min(5, Math.round(rating)));
---

<p class={`stars ${className}`}>
  <span class="sr-only">৫-এ {filled} রেটিং</span>
  {
    Array.from({ length: 5 }, (_, i) => (
      <Icon name="star" size={14} class={i < filled ? 'on' : 'off'} />
    ))
  }
</p>

<style>
  .stars {
    display: flex;
    gap: 2px;
  }

  .stars :global(.on) {
    color: var(--color-clay);
  }

  .stars :global(.off) {
    color: color-mix(in oklab, var(--color-ink) 18%, transparent);
  }
</style>
