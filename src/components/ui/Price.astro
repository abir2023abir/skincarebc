---
import { formatBdt } from '~/lib/formatBdt';
import { savingsPercent } from '~/lib/pricing';

interface Props {
  price: number;
  oldPrice?: number;
  /** Larger treatment for the product showcase. */
  size?: 'sm' | 'lg';
  showSaving?: boolean;
  class?: string;
}

const { price, oldPrice, size = 'sm', showSaving = false, class: className = '' } = Astro.props;
const saved = savingsPercent(price, oldPrice);
---

<p class={`price price-${size} ${className}`}>
  <span class="now">{formatBdt(price)}</span>
  {
    oldPrice && oldPrice > price && (
      <s class="was">
        {formatBdt(oldPrice)}
        <span class="sr-only">— আগের দাম</span>
      </s>
    )
  }
  {showSaving && saved > 0 && <span class="saved">{saved}% ছাড়</span>}
</p>

<style>
  .price {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem 0.65rem;
    font-family: var(--font-ui);
  }

  .now {
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }

  .price-sm .now {
    font-size: var(--text-lg);
  }

  .price-lg .now {
    font-size: var(--text-2xl);
  }

  .was {
    color: var(--color-ink-mute);
    font-size: var(--text-sm);
    text-decoration-thickness: 1px;
  }

  .saved {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--color-clay);
    font-family: var(--font-bn);
  }

  :global(.on-dark) .was {
    color: color-mix(in oklab, var(--color-bone) 62%, transparent);
  }

  :global(.on-dark) .saved {
    color: var(--color-clay-soft);
  }
</style>
